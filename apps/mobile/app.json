{
  "expo": {
    "name": "Zola Zola",
    "slug": "zola-mobile",
    "owner": "htuan04",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-z-foreground.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-zolazola.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef6fe"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.htuan04.mobile",
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Ứng dụng cần sử dụng nhận diện giọng nói để soạn tin nhắn bằng giọng nói.",
        "NSMicrophoneUsageDescription": "Ứng dụng cần truy cập Micro để đàm thoại và ghi âm."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-z-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.htuan04.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-media-library",
      "expo-location",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-z-foreground.png",
          "color": "#0068ff",
          "defaultChannel": "messages",
          "sounds": []
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Zalo-clone cần quyền truy cập Camera để gọi Video.",
          "microphonePermission": "Zalo-clone cần quyền truy cập Micro để đàm thoại."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện ảnh của bạn.",
          "cameraPermission": "Ứng dụng cần truy cập Máy ảnh."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-zolazola.png",
          "resizeMode": "contain",
          "backgroundColor": "#eef6fe",
          "imageWidth": 220
        }
      ],
      "expo-file-system",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4acb257f-bc24-4cb6-8fa3-492b237e9639"
      }
    }
  }
}
